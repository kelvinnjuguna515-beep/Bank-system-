balance = 5000.00
pin = "1234"
transactions = []


def login():
    attempts = 3

    while attempts > 0:
        entered_pin = input("Enter your PIN: ")

        if entered_pin == pin:
            print("\nLogin successful!")
            return True

        attempts -= 1
        print(f"Wrong PIN. Attempts remaining: {attempts}")

    print("Account locked.")
    return False


def check_balance():
    print(f"\nCurrent balance: KSh {balance:.2f}")


def deposit():
    global balance

    amount = float(input("Enter amount to deposit: KSh "))

    if amount <= 0:
        print("Invalid amount.")
        return

    balance += amount
    transactions.append(f"Deposited KSh {amount:.2f}")

    print(f"KSh {amount:.2f} deposited successfully.")


def withdraw():
    global balance

    amount = float(input("Enter amount to withdraw: KSh "))

    if amount <= 0:
        print("Invalid amount.")
        return

    if amount > balance:
        print("Insufficient balance.")
        return

    balance -= amount
    transactions.append(f"Withdrawn KSh {amount:.2f}")

    print(f"Please collect KSh {amount:.2f}.")


def transaction_history():
    print("\n===== TRANSACTION HISTORY =====")

    if not transactions:
        print("No transactions yet.")
        return

    for transaction in transactions:
        print("-", transaction)


def change_pin():
    global pin

    old_pin = input("Enter current PIN: ")

    if old_pin != pin:
        print("Incorrect PIN.")
        return

    new_pin = input("Enter new PIN: ")

    if len(new_pin) != 4 or not new_pin.isdigit():
        print("PIN must contain exactly 4 digits.")
        return

    pin = new_pin
    print("PIN changed successfully.")


def atm_menu():
    while True:
        print("\n==============================")
        print("       ATM SYSTEM")
        print("==============================")
        print("1. Check Balance")
        print("2. Deposit Money")
        print("3. Withdraw Money")
        print("4. Transaction History")
        print("5. Change PIN")
        print("6. Exit")
        print("==============================")

        choice = input("Choose an option: ")

        if choice == "1":
            check_balance()

        elif choice == "2":
            deposit()

        elif choice == "3":
            withdraw()

        elif choice == "4":
            transaction_history()

        elif choice == "5":
            change_pin()

        elif choice == "6":
            print("Thank you for using the ATM.")
            break

        else:
            print("Invalid option.")


# Start program
print("===== WELCOME TO PYTHON ATM =====")

if login():
    atm_menu()
